// Ids are generated by the domain aggregates, not by the database.
// Relations to employees use ON DELETE SET NULL: deleting an employee frees their devices and desks.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id         String           @id @db.Uuid
  fullName   String           @map("full_name") @db.VarChar(120)
  email      String?          @unique @db.VarChar(254)
  department String?          @db.VarChar(80)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  devices    Device[]
  desks      FloorMapObject[]

  @@index([fullName])
  @@map("employees")
}

// "in use" is not stored: it is derived from employeeId. Only the decommission date is persisted.
model Device {
  id               String    @id @db.Uuid
  name             String    @db.VarChar(120)
  code             String?   @unique @db.VarChar(40)
  notes            String?   @db.VarChar(500)
  employeeId       String?   @map("employee_id") @db.Uuid
  employee         Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  decommissionedAt DateTime? @map("decommissioned_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([employeeId])
  @@map("devices")
}

model FloorMap {
  id        String           @id @db.Uuid
  name      String           @db.VarChar(80)
  cols      Int              @db.SmallInt
  rows      Int              @db.SmallInt
  walls     String[]
  labels    Json             @default("[]")
  // Optimistic locking: every layout save must send the version it was based on.
  version   Int              @default(0)
  objects   FloorMapObject[]
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("floor_maps")
}

model FloorMapObject {
  id         String    @id @db.Uuid
  mapId      String    @map("map_id") @db.Uuid
  map        FloorMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  typeId     String    @map("type_id") @db.VarChar(32)
  row        Int       @db.SmallInt
  col        Int       @db.SmallInt
  rotation   Int       @db.SmallInt
  employeeId String?   @map("employee_id") @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([mapId])
  @@index([employeeId])
  @@map("floor_map_objects")
}
